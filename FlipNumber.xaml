<UserControl x:Class="CodexUsageWidget.FlipNumber"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="31" Height="24"
             FontFamily="Consolas" FontSize="19" FontWeight="Bold"
             Foreground="#244B70" Background="Transparent"
             FlowDirection="LeftToRight"
             Focusable="False" IsTabStop="False" IsHitTestVisible="False"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             AutomationProperties.Name="--">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="TopGlass" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FCFEFF" Offset="0" />
            <GradientStop Color="#F3FAFF" Offset="0.45" />
            <GradientStop Color="#DFEEFC" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BottomGlass" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5FAFF" Offset="0" />
            <GradientStop Color="#E6F2FE" Offset="0.55" />
            <GradientStop Color="#DCEBFA" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="NumberText" TargetType="TextBlock">
            <Setter Property="Text" Value="--" />
            <Setter Property="Width" Value="31" />
            <Setter Property="Height" Value="24" />
            <Setter Property="LineHeight" Value="24" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="12" />
            <RowDefinition Height="12" />
        </Grid.RowDefinitions>
        <!-- Each clipped half contains the same full, aligned two-digit face. -->
        <Border x:Name="StaticTopHalf" Grid.Row="0" CornerRadius="3,3,0,0"
                Background="{StaticResource TopGlass}" ClipToBounds="True">
            <Canvas ClipToBounds="True">
                <TextBlock x:Name="StaticTopText" Style="{StaticResource NumberText}" />
            </Canvas>
        </Border>
        <Border x:Name="StaticBottomHalf" Grid.Row="1" CornerRadius="0,0,3,3"
                Background="{StaticResource BottomGlass}" ClipToBounds="True">
            <Canvas ClipToBounds="True">
                <TextBlock x:Name="StaticBottomText" Canvas.Top="-12"
                           Style="{StaticResource NumberText}" />
            </Canvas>
        </Border>
        <Border x:Name="OldTopHalf" Grid.Row="0" CornerRadius="3,3,0,0"
                Background="{StaticResource TopGlass}" ClipToBounds="True"
                RenderTransformOrigin="0.5,1" Visibility="Collapsed">
            <Border.RenderTransform>
                <ScaleTransform x:Name="TopFoldScale" ScaleY="1" />
            </Border.RenderTransform>
            <Canvas ClipToBounds="True">
                <TextBlock x:Name="OldTopText" Style="{StaticResource NumberText}" />
            </Canvas>
        </Border>
        <Border x:Name="NewBottomHalf" Grid.Row="1" CornerRadius="0,0,3,3"
                Background="{StaticResource BottomGlass}" ClipToBounds="True"
                RenderTransformOrigin="0.5,0" Visibility="Collapsed">
            <Border.RenderTransform>
                <ScaleTransform x:Name="BottomFoldScale" ScaleY="0" />
            </Border.RenderTransform>
            <Canvas ClipToBounds="True">
                <TextBlock x:Name="NewBottomText" Canvas.Top="-12"
                           Style="{StaticResource NumberText}" />
            </Canvas>
        </Border>
        <Border Grid.RowSpan="2" BorderBrush="#9FBED9" BorderThickness="1" CornerRadius="3" />
        <Border Grid.RowSpan="2" Height="1" Margin="1,0" VerticalAlignment="Center"
                Background="#789DBD" Opacity="0.5" />
    </Grid>
</UserControl>

<Window x:Class="CodexUsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexUsageWidget"
        Title="{DynamicResource UiText000}" Icon="Assets/mali-yaya.ico" Width="294" MinWidth="142" MaxWidth="320"
        MinHeight="40" MaxHeight="430" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="False" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontWeight="SemiBold"
        Loaded="Window_Loaded" Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{DynamicResource UiText001}" Click="DetectCodex_Click"/>
            <MenuItem Header="{DynamicResource UiText002}" Click="ChooseCodex_Click"/>
            <Separator/>
            <MenuItem Header="{DynamicResource UiText003}" Click="ConnectionInfo_Click"/>
            <Separator/>
            <MenuItem x:Name="AutoUpdateMenu" Header="{DynamicResource UiText004}" IsCheckable="True" Click="AutoUpdate_Click"/>
            <MenuItem Header="{DynamicResource UiText005}" Click="ConfigureUpdate_Click"/>
            <MenuItem Header="{DynamicResource UiText006}" Click="UpdateInfo_Click"/>
            <MenuItem x:Name="UpdateStatusMenu" Header="{DynamicResource UiText007}" IsEnabled="False"/>
            <Separator/>
            <MenuItem x:Name="TiboNetworkMenu" Header="{DynamicResource UiText035}" IsCheckable="True" Click="TiboNetwork_Click"/>
            <MenuItem x:Name="CompactModeMenu" Header="{DynamicResource UiText036}" IsCheckable="True" Click="CompactMode_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#16251F"/>
        <SolidColorBrush x:Key="Muted" Color="#52665D"/>
        <SolidColorBrush x:Key="SoftMuted" Color="#6A7D73"/>
        <SolidColorBrush x:Key="Track" Color="#426A756C"/>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#53685D"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#55FFFFFF"/>
                                <Setter Property="Foreground" Value="#17231D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UsageProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="{StaticResource Track}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse Width="190" Height="120" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-28,-26,0" Fill="#51FFFFFF" Opacity="0.26" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="24"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="148" Height="110" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-30,0,0,-34" Fill="#3D8CD2C8" Opacity="0.22" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="28"/></Ellipse.Effect>
        </Ellipse>

        <Border x:Name="Shell" CornerRadius="18" BorderBrush="#B8FFFFFF" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E8F8FCFA" Offset="0"/>
                    <GradientStop Color="#DDE9F3EE" Offset="0.48"/>
                    <GradientStop Color="#D4DCEBE4" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.18" Color="#29483D"/>
            </Border.Effect>
            <Grid ClipToBounds="True">
                <Border Margin="1" CornerRadius="17" BorderBrush="#38FFFFFF" BorderThickness="1"
                        Background="#16FFFFFF" IsHitTestVisible="False"/>
                <Grid Margin="8,5,8,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="PetStatusDot" Width="6" Height="6" Fill="#0FA76A" Margin="1,0,5,0"/>
                            <TextBlock x:Name="BrandText" Text="{DynamicResource UiText000}" Foreground="{StaticResource Ink}"
                                       FontWeight="Bold" FontSize="12.5"/>
                            <Border x:Name="PlanBadge" Background="#42FFFFFF" CornerRadius="6"
                                    Margin="5,0,0,0" Padding="5,1">
                                <TextBlock x:Name="PlanText" Text="--" Foreground="#40564B"
                                           FontWeight="Bold" FontSize="9.5"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="↻"
                                    ToolTip="{DynamicResource UiText008}" Click="Refresh_Click"/>
                            <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Content="⌃"
                                    ToolTip="{DynamicResource UiText009}" Click="Collapse_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="×"
                                    ToolTip="{DynamicResource UiText010}" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="DetailsPanel" Grid.Row="1" Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="OverviewPanel" Grid.Row="0" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Width="46" VerticalAlignment="Top" Margin="0,2,2,0"
                                        ClipToBounds="True">
                                <Viewbox x:Name="MascotViewport" Width="43" Height="64" Stretch="Uniform" HorizontalAlignment="Center">
                                    <Grid x:Name="AvatarContainer" Width="72" Height="108" Cursor="Hand"
                                          RenderTransformOrigin="0.5,0.55"
                                          MouseEnter="Avatar_MouseEnter" MouseLeave="Avatar_MouseLeave"
                                          MouseLeftButtonDown="Avatar_MouseLeftButtonDown">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="CharacterScale" ScaleX="1" ScaleY="1"/>
                                                <RotateTransform x:Name="CharacterRotate" Angle="0"/>
                                                <TranslateTransform x:Name="CharacterTranslate" Y="0"/>
                                            </TransformGroup>
                                        </Grid.RenderTransform>
                                        <Canvas x:Name="OriginalMascot" Width="72" Height="104"
                                                AutomationProperties.Name="{DynamicResource UiText011}"
                                                ToolTip="{DynamicResource UiText012}">
                                            <Canvas.RenderTransform>
                                                <ScaleTransform ScaleX="0.88" ScaleY="0.88" CenterX="36" CenterY="56"/>
                                            </Canvas.RenderTransform>
                                            <Ellipse x:Name="CharacterAura" Canvas.Left="7" Canvas.Top="14"
                                                     Width="58" Height="85" Fill="#40A8E7B4" Opacity="0"/>
                                            <Ellipse Canvas.Left="15" Canvas.Top="95" Width="42" Height="5"
                                                     Fill="#22455450"/>
                                            <Rectangle Canvas.Left="16" Canvas.Top="89" Width="18" Height="10"
                                                       RadiusX="5" RadiusY="5" Fill="#284D4F"/>
                                            <Rectangle Canvas.Left="38" Canvas.Top="89" Width="18" Height="10"
                                                       RadiusX="5" RadiusY="5" Fill="#284D4F"/>
                                            <Ellipse x:Name="LeftArm" Canvas.Left="14" Canvas.Top="60"
                                                     Width="10" Height="20" Stroke="#B58A5C" StrokeThickness="1"
                                                     RenderTransformOrigin="0.5,0.12" Panel.ZIndex="1">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FFF0C9"/>
                                                        <GradientStop Color="#E9B37D" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                                <Ellipse.RenderTransform><RotateTransform x:Name="LeftArmRotate" Angle="18"/></Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Ellipse x:Name="RightArm" Canvas.Left="48" Canvas.Top="60"
                                                     Width="10" Height="20" Stroke="#B58A5C" StrokeThickness="1"
                                                     RenderTransformOrigin="0.5,0.12" Panel.ZIndex="1">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FFF0C9"/>
                                                        <GradientStop Color="#E9B37D" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                                <Ellipse.RenderTransform><RotateTransform x:Name="RightArmRotate" Angle="-18"/></Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Rectangle x:Name="CharacterBody" Canvas.Left="18" Canvas.Top="57"
                                                       Width="36" Height="34" RadiusX="12" RadiusY="12"
                                                       Stroke="#BD9468" StrokeThickness="1.2">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.85,1">
                                                        <GradientStop Color="#FFF2CE"/>
                                                        <GradientStop Color="#F1C28F" Offset="0.65"/>
                                                        <GradientStop Color="#D9A66F" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Ellipse x:Name="CharacterStatusGlow" Canvas.Left="24" Canvas.Top="62"
                                                     Width="24" Height="24" Fill="#70B1F2C8" Opacity="0"/>
                                            <Path x:Name="CharacterStatusLight" Data="M 36,66 L 42,72 L 36,78 L 30,72 Z"
                                                  Fill="#438B75" Stroke="#FFF5D7" StrokeThickness="1.5"/>
                                            <Line X1="29" Y1="83" X2="32" Y2="83" Stroke="#B68D60" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line X1="35" Y1="83" X2="38" Y2="83" Stroke="#B68D60" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line X1="41" Y1="83" X2="44" Y2="83" Stroke="#B68D60" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Path Data="M 36,26 Q 36,20 32,18" Stroke="#448F77" StrokeThickness="2.2" StrokeEndLineCap="Round"/>
                                            <Path x:Name="LeftLeaf" Data="M 34,22 C 24,24 21,20 21,14 C 29,14 34,16 34,22 Z"
                                                  Fill="#8ED5A8" Stroke="#448F77" StrokeThickness="0.8"/>
                                            <Path x:Name="RightLeaf" Data="M 36,22 C 36,15 43,13 51,15 C 48,22 43,25 36,22 Z"
                                                  Fill="#C4E7A2" Stroke="#6C9E68" StrokeThickness="0.8"/>
                                            <Rectangle x:Name="CharacterHead" Canvas.Left="6" Canvas.Top="24"
                                                       Width="60" Height="38" RadiusX="12" RadiusY="12"
                                                       Stroke="#377D73" StrokeThickness="1.2">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#B5F2DB"/>
                                                        <GradientStop Color="#70C9B0" Offset="0.5"/>
                                                        <GradientStop Color="#449A8D" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Rectangle Canvas.Left="11" Canvas.Top="27" Width="50" Height="3"
                                                       RadiusX="1.5" RadiusY="1.5" Fill="#85FFFFFF"/>
                                            <Rectangle x:Name="CharacterScreen" Canvas.Left="12" Canvas.Top="30"
                                                       Width="48" Height="26" RadiusX="8" RadiusY="8" Stroke="#70C6AF" StrokeThickness="0.8">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#264B4A"/>
                                                        <GradientStop Color="#173B3E" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Ellipse x:Name="LeftPupil" Canvas.Left="25" Canvas.Top="33"
                                                     Width="5" Height="7" Fill="#CCFFE4"/>
                                            <Ellipse x:Name="RightPupil" Canvas.Left="42" Canvas.Top="33"
                                                     Width="5" Height="7" Fill="#CCFFE4"/>
                                            <Path x:Name="CharacterMouth" Data="M 24,43 Q 36,54 49,43"
                                                  Stroke="#A9EACD" StrokeThickness="1.8" Fill="Transparent"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Path x:Name="LeftBrow" Data="M 24,32 L 31,33"
                                                  Stroke="#CCFFE4" StrokeThickness="1.3" Visibility="Collapsed"/>
                                            <Path x:Name="RightBrow" Data="M 41,33 L 48,32"
                                                  Stroke="#CCFFE4" StrokeThickness="1.3" Visibility="Collapsed"/>
                                        </Canvas>
                                    </Grid>
                                </Viewbox>
                                <TextBlock x:Name="PetMoodText" Width="46" Text="{DynamicResource UiText013}"
                                           TextAlignment="Center" Foreground="#40584D"
                                           FontWeight="Bold" FontSize="9" Margin="0,1,0,0"/>
                                <Border x:Name="PetCountdownPanel" Margin="0,4,0,0" Padding="0,2"
                                        CornerRadius="6" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="PetCountdownTitle" Text="{DynamicResource UiText014}" FontSize="8.5" FontWeight="Bold"
                                                   Foreground="#40584D" TextAlignment="Center"/>
                                        <StackPanel x:Name="CountdownNumbers" Width="44" Margin="0,3,0,0">
                                            <Grid Height="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="12"/>
                                                </Grid.ColumnDefinitions>
                                                <local:FlipNumber x:Name="HoursFlip"/>
                                                <TextBlock Grid.Column="1" Text="{DynamicResource UiText015}" FontSize="8.5" FontWeight="Bold"
                                                           Foreground="#40584D" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </Grid>
                                            <Grid Height="24" Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="12"/>
                                                </Grid.ColumnDefinitions>
                                                <local:FlipNumber x:Name="MinutesFlip"/>
                                                <TextBlock Grid.Column="1" Text="{DynamicResource UiText016}" FontSize="8.5" FontWeight="Bold"
                                                           Foreground="#40584D" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </Grid>
                                            <Grid Height="24" Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="12"/>
                                                </Grid.ColumnDefinitions>
                                                <local:FlipNumber x:Name="SecondsFlip"/>
                                                <TextBlock Grid.Column="1" Text="{DynamicResource UiText017}" FontSize="8.5" FontWeight="Bold"
                                                           Foreground="#40584D" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock x:Name="PetCountdownStatus" Text="{DynamicResource UiText018}" FontSize="8.5"
                                                   FontWeight="Bold" Foreground="#087C9B" TextAlignment="Center"
                                                   Visibility="Collapsed" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <StackPanel>
                                    <Border x:Name="FiveHourCard" Visibility="Collapsed" Margin="0,0,0,4"
                                            MinHeight="58" Background="#48FFFFFF" BorderBrush="#86FFFFFF"
                                            BorderThickness="1" CornerRadius="11" Padding="7,5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="FiveHourLabel" Text="{DynamicResource UiText019}" Foreground="{StaticResource Ink}"
                                                       FontWeight="Bold" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="FiveHourRemainingText" Grid.Column="1" Text="--%"
                                                       Foreground="#15966A" FontWeight="Bold" FontSize="16" Margin="5,-2,0,0"/>
                                            <TextBlock x:Name="FiveHourHintText" Grid.Column="2" Text="--"
                                                       Foreground="{StaticResource Muted}" FontWeight="Bold"
                                                       FontSize="9.5" Margin="5,1,0,0" TextAlignment="Right"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="FiveHourUsedText" Text="{DynamicResource UiText020}"
                                                           Foreground="{StaticResource Muted}"
                                                           FontWeight="SemiBold" FontSize="9"/>
                                                <TextBlock x:Name="FiveHourResetText" Grid.Column="1"
                                                           Text="{DynamicResource UiText021}" Foreground="{StaticResource Muted}"
                                                           FontWeight="SemiBold" FontSize="9" Margin="5,0,0,0"
                                                           TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            <ProgressBar x:Name="FiveHourProgress" Grid.Row="2" Grid.ColumnSpan="3"
                                                         Style="{StaticResource UsageProgress}" Foreground="#25B883"
                                                         Maximum="100" Margin="0,4,0,0"/>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="WeeklyCard" MinHeight="58" Background="#48FFFFFF"
                                            BorderBrush="#86FFFFFF" BorderThickness="1" CornerRadius="11"
                                            Padding="7,5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="WeeklyLabel" Text="{DynamicResource UiText022}" Foreground="{StaticResource Ink}"
                                                       FontWeight="Bold" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="WeeklyRemainingText" Grid.Column="1" Text="--%"
                                                       Foreground="#176FB3" FontWeight="Bold" FontSize="16" Margin="5,-2,0,0"/>
                                            <TextBlock x:Name="WeeklyHintText" Grid.Column="2" Text="--"
                                                       Foreground="{StaticResource Muted}" FontWeight="Bold"
                                                       FontSize="9.5" Margin="5,1,0,0" TextAlignment="Right"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="WeeklyUsedText" Text="{DynamicResource UiText020}"
                                                           Foreground="{StaticResource Muted}"
                                                           FontWeight="SemiBold" FontSize="9"/>
                                                <TextBlock x:Name="WeeklyResetText" Grid.Column="1"
                                                           Text="{DynamicResource UiText021}" Foreground="{StaticResource Muted}"
                                                           FontWeight="SemiBold" FontSize="9" Margin="5,0,0,0"
                                                           TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            <ProgressBar x:Name="WeeklyProgress" Grid.Row="2" Grid.ColumnSpan="3"
                                                         Style="{StaticResource UsageProgress}" Foreground="#3B96D9"
                                                         Maximum="100" Margin="0,4,0,0"/>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="NoLimitsCard" Visibility="Collapsed" MinHeight="55"
                                            Background="#48FFFFFF" BorderBrush="#86FFFFFF"
                                            BorderThickness="1" CornerRadius="11" Padding="8,6">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource UiText023}" Foreground="{StaticResource Ink}"
                                                       FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="{DynamicResource UiText024}" Foreground="{StaticResource Muted}"
                                                       FontWeight="SemiBold" FontSize="9" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border x:Name="AgentPanel" Margin="0,4,0,0"
                                        Background="#3A238F76" BorderBrush="#6B65B59B"
                                        BorderThickness="1" CornerRadius="9" Padding="7,5"
                                        Cursor="Hand" MouseLeftButtonDown="AgentPanel_MouseLeftButtonDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="AgentStatusDot" Width="6" Height="6" Fill="#1A9C6B"
                                                 VerticalAlignment="Top" Margin="0,4,5,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="AgentTitleText" Text="{DynamicResource UiText025}"
                                                       Foreground="{StaticResource Ink}" FontWeight="Bold"
                                                       FontSize="10" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="AgentAdviceText" Text="{DynamicResource UiText026}"
                                                       Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="9"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid x:Name="ResetInfoRow" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource UiText027}" Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="9"/>
                                    <TextBlock x:Name="ResetChanceText" Grid.Column="1" Text="{DynamicResource UiText028}"
                                               Foreground="#9A5800" FontWeight="Bold" FontSize="9"
                                               Margin="4,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Credits" Grid.Column="2" Foreground="{StaticResource Muted}"
                                               FontWeight="SemiBold" FontSize="9" Margin="5,0,0,0"/>
                                    <TextBlock x:Name="CreditsText" Text="--" Grid.Column="3"
                                               Foreground="{StaticResource Ink}" FontWeight="Bold"
                                               FontSize="9" Margin="3,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="TiboPanel" Grid.ColumnSpan="2" Grid.Row="1"
                                Margin="0,4,0,0" Padding="8,6" CornerRadius="12"
                                BorderBrush="#FF5A9FC5" BorderThickness="1.3" Cursor="Hand"
                                MouseLeftButtonDown="TiboPanel_MouseLeftButtonDown">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E8E8F7FE" Offset="0"/>
                                    <GradientStop Color="#D7D5ECF8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="33"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="TiboSignalShell" Width="27" Height="27"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        CornerRadius="14" Background="#168DC4"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform x:Name="TiboSignalRotate" Angle="0"/>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Path Data="M 8,19 C 6,11 12,7 20,8 C 21,16 16,22 8,19 Z"
                                              Fill="#C4EDB3" Stroke="#E9FFE4" StrokeThickness="1"/>
                                        <Path Data="M 9,18 L 17,11 M 13,14 L 13,11"
                                              Stroke="#347B69" StrokeThickness="1.3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource UiText029}" Foreground="#17638F"
                                                   FontWeight="Bold" FontSize="9"/>
                                        <TextBlock x:Name="TiboOpenText" Grid.Column="1" Text="{DynamicResource UiText030}"
                                                   Foreground="#17638F" FontWeight="Bold" FontSize="8.5"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                    <TextBlock x:Name="TiboHeadlineText" Text="{DynamicResource UiText031}"
                                               Foreground="#17384C" FontWeight="Bold"
                                               FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TiboDetailText" Text="{DynamicResource UiText032}"
                                               Foreground="#34596B" FontWeight="SemiBold" FontSize="9.5"
                                               TextWrapping="Wrap" MaxHeight="38" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TiboOriginalText" Visibility="Collapsed"
                                               Foreground="#53707E" FontWeight="SemiBold" FontSize="9"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                               MouseLeftButtonDown="LatestTiboPost_MouseLeftButtonDown"/>
                                    <TextBlock x:Name="TiboChineseText" Visibility="Collapsed"
                                               Foreground="#174B64" FontWeight="Bold" FontSize="10"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               LineHeight="14" MaxHeight="42" Margin="0,3,0,0"
                                               MouseLeftButtonDown="LatestTiboPost_MouseLeftButtonDown"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.ColumnSpan="2" Grid.Row="2" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusText" Text="{DynamicResource UiText033}" Foreground="{StaticResource Muted}"
                                       FontWeight="SemiBold" FontSize="8.5" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="StartupCheckBox" Grid.Column="1" Content="{DynamicResource UiText034}"
                                      Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="8.5"
                                      VerticalAlignment="Center" Margin="4,0,0,0"
                                      Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed"/>
                        </Grid>
                    </Grid>
                </Grid>

                <Border x:Name="GlassSheen" Height="24" Width="88"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        CornerRadius="12" Opacity="0.16" IsHitTestVisible="False"
                        Panel.ZIndex="3">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#BFFFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="GlassSheenTransform" X="-100"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
